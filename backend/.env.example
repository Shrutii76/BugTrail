
# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/BugTrail

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# GitHub OAuth (configure when implementing GitHub integration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/github/callback

# GitHub Webhooks (configure when implementing webhooks)
GITHUB_WEBHOOK_SECRET=
